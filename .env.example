# ─── Kura CRM frontend environment ─────────────────────────
# Copy to .env.development / .env.production and adjust as needed.
# Only VITE_* variables are exposed to the browser bundle.

# Application identity (surfaced in the UI, logging, and Sentry releases).
VITE_APP_NAME=Kura CRM
VITE_APP_VERSION=3.0.0

# API endpoints. In development these paths are proxied to
# http://localhost:5000 by Vite; in production nginx proxies them to the API service.
VITE_API_BASE_URL=
VITE_GRAPHQL_URL=/graphql

# Error monitoring (Sentry). Leave empty to disable.
# DSNs are public — the token secret below is separate.
VITE_SENTRY_DSN=

# Client log level: debug | info | warn | error
VITE_LOG_LEVEL=debug

# ─── Build-time Sentry source map upload (CI only) ─────────
# These are read by vite.config.ts during `vite build`. Never
# expose VITE_SENTRY_AUTH_TOKEN to the browser.
# SENTRY_ORG=
# SENTRY_PROJECT=
# VITE_SENTRY_AUTH_TOKEN=