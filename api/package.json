{
  "name": "kura-crm-api",
  "version": "3.0.0",
  "description": "Enterprise-grade CRM API with TypeScript, GraphQL, Auth, RBAC, Monitoring, K8s, and CI/CD",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "build": "rimraf dist && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "tsx src/utils/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist logs coverage"
  },
  "author": "Kura CRM Team",
  "license": "ISC",
