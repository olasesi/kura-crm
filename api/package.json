    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.9.0",
    "graphql-tools": "^9.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.1",
    "opossum": "^8.0.0",
    "otplib": "^13.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
