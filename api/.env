# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Auth (Account Lockout) ──────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ─── MFA (TOTP) ──────────────────────────────────────
MFA_TOKEN_EXPIRES_IN=5m

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_database
DB_PORT=3306

# ─── JWT Authentication ───────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars!!
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GraphQL ──────────────────────────────────────────
GRAPHQL_PATH=/graphql

# ─── Google reCAPTCHA ─────────────────────────────────
# RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ─── Sentry (Error Tracking) ─────────────────────────
# SENTRY_DSN=https://your-dsn@sentry.io/123456

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug
