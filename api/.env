# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_database
DB_PORT=3306

# ─── JWT Authentication ───────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars!!
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug
